# Vibe Kanban Self-Hosted — Environment Configuration
# Copy to .env and fill in values

# Generate with: openssl rand -hex 24
DB_PASSWORD=<GENERATE_ME>
ELECTRIC_ROLE_PASSWORD=<GENERATE_ME>

# Generate with: openssl rand -base64 48 (must decode to >=32 bytes)
VIBEKANBAN_REMOTE_JWT_SECRET=<GENERATE_ME>

# Your public URL (via Cloudflare Tunnel or Tailscale)
PUBLIC_BASE_URL=https://your-domain.example.com

# Image tag (don't change unless rebuilding)
IMAGE_TAG=0.1.43-local-v2

# Local auth (admin login)
SELF_HOST_LOCAL_AUTH_EMAIL=admin@example.com
SELF_HOST_LOCAL_AUTH_PASSWORD=<YOUR_PASSWORD>

# Remote server port binding
REMOTE_SERVER_PORTS=127.0.0.1:8081:8081

# Relay URL (baked into frontend at build time)
VITE_RELAY_API_BASE_URL=http://localhost:8082

# MiniMax API key (for OpenCode)
MINIMAX_API_KEY=<YOUR_MINIMAX_TOKEN_PLAN_KEY>

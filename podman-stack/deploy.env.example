# === vibe-kanban 單機自架:部署參數檔(非密鑰;密鑰在 stack 目錄的 .env)===
# 本機 = woowtechcluster1(Tailscale 100.94.76.110)。存取模式:Tailscale-only(無 Cloudflare)。
# ⚠️ 本機 port 3100 的 v0.1.32 daily driver(systemd user unit vibe-kanban.service)絕不可動。

# --- 目標主機 ---
STACK_DIR="$HOME/vibe-kanban-stack"          # 部署根目錄(src/、compose、腳本都在這)
SRC_DIR="$STACK_DIR/src"                      # vibe-kanban 原始碼 clone 位置
VK_TAG="v0.1.43-20260417125614"               # 鎖定 tag(0.1.44 上游砍功能,勿升)

# --- 對外(2026-07-06 改:Cloudflare tunnel HTTPS,VPN+LAN 皆走 https/h2;
#     原因:純 HTTP = 非 secure context(crypto API 全滅)+ HTTP/1.1 6 連線上限
#     造成 Electric long-poll 排隊 → 建 issue TimeoutWaitingForTxId)---
TS_IP="100.94.76.110"
LAN_IP="192.168.2.253"                        # 本機 k3s node IP,vibe-kanban-k3s tunnel 的 cloudflared pod 由此打進來
REMOTE_DOMAIN="woowtechcluster1-vibekanban.woowtech.io"
RELAY_DOMAIN="woowtechcluster1-vibekanban-relay.woowtech.io"
HOST_DOMAIN="woowtechcluster1-vibekanban-host.woowtech.io"
REMOTE_URL="https://${REMOTE_DOMAIN}"
RELAY_URL="https://${RELAY_DOMAIN}"

# --- 本機 port(ss -ltn 已確認未占用;8081/8082 舊容器已死、3200 空)---
REMOTE_PORT=8081
RELAY_PORT=8082
HOST_PORT=3000                                # 原生 host UI(2026-07-06:舊 0.1.44 system unit 已 disable,3000 讓給本 host;3100 是 daily driver)

# --- host 資料隔離(關鍵!預設 ~/.local/share/vibe-kanban 屬於 3100 daily driver)---
VK_XDG_DATA_HOME="$HOME/.local/share-vk-stack"

# --- host 連線目標(2026-07-06 定案:本機 host 連本機 podman remote/relay;
#     k3s 的 vk-host 自己連 k3s package,兩邊獨立)---
HOST_REMOTE_URL="$REMOTE_URL"                 # http://100.94.76.110:8081(TS IP,tailnet 瀏覽器也打得到)
HOST_RELAY_URL="$RELAY_URL"
HOST_BIN="$STACK_DIR/bin/server"              # 預建 v0.1.43 release binary(copy 自 ~/vibe-kanban-0143;
                                              # baked URL 無所謂,runtime env 會覆蓋,前端由 /api/info 取得)

# --- image tag ---
IMAGE_TAG="0.1.43-local-v2"

# --- Cloudflare(2026-07-06 啟用:借用 k3s 的 vibe-kanban-k3s token tunnel,
#     其 cloudflared pod 跑在 woowtechcluster8,經 LAN 打回本機 192.168.2.253;
#     API token 見 skill private-credentials.md)---
CF_ACCOUNT_ID="9c27f623ee596e0b67be56263bcb1974"
CF_TUNNEL_ID="26807ba5-a0bf-409b-808a-2d6378e50d60"   # vibe-kanban-k3s
CF_ZONE_ID="4d12cea85ec6022e42b72015c43e5513"          # woowtech.io

# --- libclang(host 原生 build 需要;Ubuntu 24.04 llvm-18)---
LIBCLANG_PATH="/usr/lib/llvm-18/lib"

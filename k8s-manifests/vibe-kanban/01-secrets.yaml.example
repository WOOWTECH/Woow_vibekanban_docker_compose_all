apiVersion: v1
kind: Secret
metadata:
  name: vk-secrets
  namespace: vibe-kanban
  labels:
    app.kubernetes.io/part-of: vibe-kanban
type: Opaque
stringData:
  # Generate with: openssl rand -base64 48 (must decode to >=32 bytes)
  VIBEKANBAN_REMOTE_JWT_SECRET: "<GENERATE_ME>"
  # Generate with: openssl rand -base64 24
  ELECTRIC_ROLE_PASSWORD: "<GENERATE_ME>"
  # Generate with: openssl rand -base64 24
  POSTGRES_PASSWORD: "<GENERATE_ME>"
  # Admin login for the self-hosted Vibe Kanban instance
  SELF_HOST_LOCAL_AUTH_EMAIL: "admin@example.com"
  SELF_HOST_LOCAL_AUTH_PASSWORD: "<YOUR_PASSWORD>"
  # Pre-constructed database URLs (K8s $(VAR) expansion doesn't work with valueFrom)
  # URL-encode any +, /, = characters in passwords
  SERVER_DATABASE_URL: "postgres://remote:<URL_ENCODED_POSTGRES_PASSWORD>@vk-db-svc:5432/remote"
  ELECTRIC_DATABASE_URL: "postgresql://electric_sync:<URL_ENCODED_ELECTRIC_ROLE_PASSWORD>@vk-db-svc:5432/remote?sslmode=disable"
  # MiniMax API key for OpenCode (optional, can use other providers)
  MINIMAX_API_KEY: "<YOUR_MINIMAX_API_KEY>"
